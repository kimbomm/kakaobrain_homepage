    "nuxt": "^2.15.7",
    "swiper": "^5.3.7",
    "vue-awesome-swiper": "^4.1.1",
    "vue-device-detector": "^1.1.6"
  },
  "devDependencies": {
    "@nuxtjs/style-resources": "^1.2.1",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^19.0.2",
    "eslint-config-prettier": "^8.3.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.2.0",
    "node-sass": "^6.0.1",
